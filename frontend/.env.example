# Sablon za frontend/.env. Kopiraj ga: copy .env.example .env

# Adresa Laravel API-ja. Vite pusta u frontend samo promenljive koje pocinju sa VITE_.
# Sve VITE_ vrednosti zavrse u JavaScript-u koji browser preuzme: ovde NIKAD lozinke ni tajni kljucevi.
# Vrednost se upisuje u kod pri "npm run build"; posle promene adrese treba novi build.
VITE_API_URL=http://localhost:8000/api
