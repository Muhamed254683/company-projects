meta {
  name: Update user (without password)
  type: http
  seq: 6
}

put {
  url: {{base_url}}/users/{{user_id}}
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "company_id": null,
    "first_name": "Ana",
    "last_name": "Testić",
    "email": "ana.bruno.{{random_suffix}}@example.com",
    "job_title": "Frilenser"
  }
}

docs {
  Bez polja "password" lozinka ostaje ista.
  "company_id": null pretvara korisnika u frilensera (bez glavne firme).
}

assert {
  res.status: eq 200
  res.body.data.company_id: isNull
  res.body.data.job_title: eq Frilenser
}
