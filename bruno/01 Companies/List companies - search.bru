meta {
  name: List companies - search
  type: http
  seq: 8
}

get {
  url: {{base_url}}/companies?search=d.o.o
  body: none
  auth: none
}

params:query {
  search: d.o.o
}

headers {
  Accept: application/json
}

docs {
  Pretraga po nazivu, PIB-u, gradu i emailu. Moze i filter po gradu: ?city=Beograd
  Mala/velika slova i kvacice se ne razlikuju (MySQL): "cacak" nalazi "Čačak"; "dj" nalazi i "đ".
}

assert {
  res.status: eq 200
}

tests {
  test("svaki rezultat sadrzi trazeni tekst", function () {
    res.body.data.forEach((company) => expect(company.name.toLowerCase()).to.include("d.o.o"));
  });
}
