meta {
  name: Forgot password
  type: http
  seq: 5
}

post {
  url: {{base_url}}/forgot-password
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "nepostoji.{{random_registration}}@example.com"
  }
}

docs {
  Salje email sa linkom za novu lozinku (link vodi na React: FRONTEND_URL/reset-password?token=...&email=...).
  Odgovor je ISTI i kada email ne postoji (kao ovde), da niko ne moze da proverava koji nalozi postoje.
  Lokalno se emailovi ne salju (MAIL_MAILER=log): email sa linkom je na kraju backend/storage/logs/laravel.log.
  Link vazi 60 minuta i samo jednom. Najvise 5 zahteva u minuti sa iste IP adrese (zajedno sa reset-password).
}

assert {
  res.status: eq 200
}

tests {
  test("ista poruka bez obzira da li nalog postoji", function () {
    expect(res.body.message).to.equal("If an account with that email exists, we have sent a password reset link.");
  });
}
