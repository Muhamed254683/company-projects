meta {
  name: Reset password - invalid token 422
  type: http
  seq: 6
}

post {
  url: {{base_url}}/reset-password
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "token": "pogresan-token",
    "email": "admin@example.com",
    "password": "novalozinka1",
    "password_confirmation": "novalozinka1"
  }
}

docs {
  Postavlja novu lozinku; token i email stizu iz linka u emailu ("Forgot password").
  Uspeh (200) brise sve tokene korisnika: odjavljen je sa svih uredjaja.
  Ovde je token pogresan, pa je odgovor 422 i lozinka se NE menja. Ista poruka i za istekao ili vec iskoriscen link.
}

assert {
  res.status: eq 422
}

tests {
  test("poruka za los link", function () {
    expect(res.body.errors.email[0]).to.equal("This password reset link is invalid or has expired.");
  });
}
