meta {
  name: Login - wrong password 422
  type: http
  seq: 1
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "admin@example.com",
    "password": "pogresna-lozinka"
  }
}

docs {
  Pogresna lozinka i nepostojeci email daju ISTU poruku (napadac ne sme da sazna koji emailovi postoje).
  Najvise 5 pokusaja u minuti za isti email i IP; sesti vraca 429.
}

assert {
  res.status: eq 422
}

tests {
  test("ista poruka za pogresan email ili lozinku", function () {
    expect(res.body.errors.email[0]).to.equal("The email or password is incorrect.");
  });
}
