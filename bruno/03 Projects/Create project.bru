meta {
  name: Create project
  type: http
  seq: 3
}

post {
  url: {{base_url}}/projects
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "company_id": {{first_company_id}},
    "name": "Bruno test projekat {{random_suffix}}",
    "description": "Projekat napravljen iz Bruno kolekcije.",
    "start_date": "2026-12-01",
    "end_date": "2027-06-30",
    "budget": 12500.50
  }
}

script:pre-request {
  bru.setVar("random_suffix", String(Date.now()));
}

script:post-response {
  // Ovaj projekat koriste "04 Project members" i "05 Project images"; brise se na kraju.
  bru.setVar("project_id", res.body.data.id);
}

docs {
  Status nije poslat, pa dobija podrazumevani "planned".
}

assert {
  res.status: eq 201
  res.body.data.status: eq planned
  res.body.data.budget: eq "12500.50"
}
