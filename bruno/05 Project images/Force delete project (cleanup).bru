meta {
  name: Force delete project (cleanup)
  type: http
  seq: 11
}

delete {
  url: {{base_url}}/projects/{{project_id}}/force
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Trajno brise projekat iz korpe, zajedno sa slikama (i sa diska) i clanstvima.
  Radi samo za projekat koji je u korpi (inace 409). Brise test projekat iz foldera "03 Projects".
}

assert {
  res.status: eq 204
}
