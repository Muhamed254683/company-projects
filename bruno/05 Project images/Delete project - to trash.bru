meta {
  name: Delete project - to trash
  type: http
  seq: 5
}

delete {
  url: {{base_url}}/projects/{{project_id}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Obicno brisanje premesta projekat u korpu (soft delete).
  Slike (i na disku) i clanovi ostaju, da bi projekat mogao da se vrati.
}

assert {
  res.status: eq 204
}
