meta {
  name: Upload images
  type: http
  seq: 1
}

post {
  url: {{base_url}}/projects/{{project_id}}/images
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
}

body:multipart-form {
  images[0]: @file(files/test-image.png)
  images[1]: @file(files/test-image.jpg)
}

script:post-response {
  bru.setVar("image_id", res.body.data[0].id);
}

docs {
  Fajlovi se salju kao multipart/form-data (ne JSON).
  Dozvoljeno: jpg, jpeg, png, webp, najvise 2 MB po slici, najvise 10 slika.
  U Brunu mozes da zamenis fajlove svojim slikama (tab Body).
}

assert {
  res.status: eq 201
  res.body.data.length: eq 2
}
